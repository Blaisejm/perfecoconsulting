          <span class="text-xs bg-teal/20 text-teal font-medium px-3 py-1 rounded-full">Pilotage</span>
          <span class="text-xs bg-teal/20 text-teal font-medium px-3 py-1 rounded-full">KPI</span>
          <time class="text-xs text-gray-400" datetime="2026-08-18">18 août 2026</time>
        </div>
