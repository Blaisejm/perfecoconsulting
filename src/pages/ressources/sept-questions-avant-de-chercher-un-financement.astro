            Lire l'article complet sur perfsystemique.fr →
          </a>
        </div>

      </div>
    </section>

    <!-- Navigation série -->
    <section class="border-t border-gray-200 py-10 px-4">
      <div class="max-w-3xl mx-auto">
        <p class="text-xs font-semibold uppercase tracking-widest text-gray-500 mb-4">PerfEco Institutions — épisode 2 sur 4</p>
