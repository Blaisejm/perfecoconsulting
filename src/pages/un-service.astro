---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Vague from '../components/Vague.astro';
import PhotoBande from '../components/PhotoBande.astro';
import { image } from '../data/images.js';

// Porte 1 du site — « Remettre un service en marche ».
// Écrite dans le vocabulaire simplifié arrêté le 06/10/2026. La liste des mots
// retirés est tenue dans l'arborescence du site, pas ici.

const signes = [
  "Les délais annoncés ne sont plus tenus — et plus personne n'ose en annoncer.",
  "Les mêmes erreurs reviennent, corrigées par les mêmes personnes.",
  "Une ou deux personnes tiennent tout, et tout s'arrête quand elles ne sont pas là.",
  "Personne ne sait dire combien de dossiers sont en cours en ce moment.",
];

const etapes = [
  {
    num: '01',
    titre: "On compte ce qui est vraiment en cours",
    desc: "Pas ce qui est prévu : ce qui est ouvert, en ce moment, sur le bureau de quelqu'un. C'est presque toujours deux à trois fois plus que ce que la direction imagine, et c'est la première chose que personne n'a jamais comptée.",
  },
  {
    num: '02',
    titre: "On cherche où ça s'arrête, pas qui ralentit",
    desc: "Un service qui ne tient plus ses délais n'a presque jamais un problème de compétence. Il a un endroit précis où tout attend — une validation, une personne, un outil. On le trouve, et on le montre.",
  },
  {
    num: '03',
    titre: "On enlève, on n'ajoute pas",
    desc: "On pose une limite au nombre de dossiers ouverts en même temps. C'est contre-intuitif et c'est ce qui fait repartir un service : moins de choses commencées, plus de choses finies.",
  },
  {
    num: '04',
    titre: "On installe un rendez-vous court qui revient",
    desc: "Vingt minutes, à date fixe, avec les trois mêmes questions. C'est ce qui reste quand nous partons — et c'est ce qui empêche le service de retomber dans l'état où nous l'avons trouvé.",
  },
];

const gardez = [
  "Le compte réel des dossiers ouverts, et la limite que vous vous êtes donnée",
  "L'endroit précis où ça bloque, mesuré et non supposé",
  "Les trois questions du rendez-vous court, écrites",
  "Un chiffre que votre équipe tient elle-même, sans nous",
];
---

<Base
  title="Remettre un service en marche"
  description="Ce service n'arrive plus à tenir ce qu'il promet. Compter ce qui est réellement en cours, trouver où ça s'arrête, enlever plutôt qu'ajouter, et installer un rendez-vous court qui revient.">
  <Nav />
  <main class="pt-16">

    <!-- Accroche -->
    <section class="relative bg-navy text-white pt-24 pb-32 px-4 overflow-hidden">
      <img src={image('quotidien-reprend').src} alt="" aria-hidden="true"
        class="absolute inset-0 w-full h-full object-cover object-center opacity-25" />
      <div class="absolute inset-0 bg-gradient-to-r from-navy via-navy/95 to-navy/55"></div>
      <div class="relative max-w-3xl mx-auto">
        <p class="text-white font-semibold text-sm uppercase tracking-wide mb-3">Quand un seul service est concerné</p>
        <h1 class="text-4xl sm:text-5xl font-bold mb-6">
          Remettre un service<br />
          en marche
        </h1>
        <p class="text-gray-200 text-xl leading-relaxed italic border-l-2 border-teal pl-5">
          « Ce service n'arrive plus à tenir ce qu'il promet, et je ne sais pas par quel bout le prendre. »
        </p>
      </div>
      <Vague couleur="blanc" forme={1} />
    </section>

    <!-- Les signes -->
    <section class="py-20 px-4">
      <div class="max-w-5xl mx-auto grid lg:grid-cols-5 gap-12 items-center">
        <div class="lg:col-span-3">
          <h2 class="text-3xl font-bold text-navy mb-8">Vous reconnaissez ça&nbsp;?</h2>
          <ul class="space-y-4 mb-8">
            {signes.map(s => (
              <li class="flex gap-4 items-start">
                <span class="text-teal-dark font-bold mt-1">—</span>
                <span class="text-gray-700 text-lg leading-relaxed">{s}</span>
              </li>
            ))}
          </ul>
          <p class="text-gray-600 text-lg leading-relaxed">
            Dans presque tous les cas, l'équipe travaille déjà beaucoup. Ce n'est pas l'effort qui manque — c'est qu'il est réparti sur trop de choses à la fois.
          </p>
        </div>
        <div class="lg:col-span-2">
          <img src={image('service-au-travail').src} alt={image('service-au-travail').alt}
            loading="lazy" width="1600" height="900"
            class="w-full aspect-[4/3] object-cover object-center rounded-xl shadow-md" />
        </div>
      </div>
    </section>

    <!-- Le mécanisme -->
    <section class="bg-gray-50 py-20 px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-bold text-navy mb-8">Pourquoi en faire plus ne marche pas</h2>
        <p class="text-2xl text-navy font-semibold leading-snug mb-10">
          Un service bloqué ne manque pas de bras. Il a trop de choses commencées en même temps.
        </p>
        <p class="text-gray-700 text-lg leading-relaxed mb-5">
          Quand un service prend du retard, le réflexe est d'en démarrer davantage pour rattraper. Chaque dossier avance alors un peu moins vite, chacun passe son temps à reprendre là où il s'était arrêté, et le retard s'aggrave exactement par le geste censé le réduire.
        </p>
        <p class="text-gray-700 text-lg leading-relaxed mb-5">
          Dans le même temps, tout le service attend au même endroit — une signature, une personne, un outil. Accélérer ailleurs ne sert à rien&nbsp;: on remplit juste la file d'attente plus vite.
        </p>
        <p class="text-gray-700 text-lg leading-relaxed">
          D'où une règle simple et difficile à accepter&nbsp;: pour aller plus vite, il faut commencer moins de choses.
        </p>
      </div>
    </section>

    <!-- Ce qu'on fait -->
    <section class="py-20 px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-navy mb-12">Ce que nous faisons</h2>
        <div class="grid sm:grid-cols-2 gap-10">
          {etapes.map(e => (
            <div>
              <div class="text-5xl font-bold text-teal/20 mb-3">{e.num}</div>
              <h3 class="text-lg font-bold text-navy mb-3">{e.titre}</h3>
              <p class="text-gray-600 leading-relaxed">{e.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <PhotoBande cle="lecture-dossier" format="21/9" fond="gris"
      legende="On suit un dossier réel, de son arrivée à sa sortie — c'est lui qui dit où le service s'arrête." />

    <!-- Avec vos équipes -->
    <section class="relative bg-navy text-white pt-16 pb-24 px-4 overflow-hidden">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-bold mb-6">Nous travaillons avec vos équipes, pas à leur place</h2>
        <p class="text-gray-200 text-lg leading-relaxed mb-5">
          Ce sont elles qui connaissent le terrain, et ce sont elles qui feront vivre ce qui aura été décidé. Une équipe à qui l'on annonce une nouvelle façon de faire la subit&nbsp;; une équipe qui a compté elle-même ses dossiers ouverts n'a plus besoin qu'on la convainque.
        </p>
        <p class="text-gray-200 text-lg leading-relaxed">
          C'est aussi la raison d'être du projet&nbsp;: en travaillant ensemble sur un résultat daté, une équipe se découvre des capacités qu'aucune fiche de poste n'annonçait. <span class="text-white font-semibold">Une addition de compétences ne fait pas une équipe — un projet mené à son terme, oui.</span>
        </p>
      </div>
      <Vague couleur="blanc" forme={2} />
    </section>

    <!-- Ce que vous gardez -->
    <section class="py-20 px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-bold text-navy mb-8">Ce que vous gardez</h2>
        <ul class="space-y-4 mb-10">
          {gardez.map(g => (
            <li class="flex gap-4 items-start">
              <span class="w-2 h-2 rounded-full bg-teal mt-3 shrink-0"></span>
              <span class="text-gray-700 text-lg leading-relaxed">{g}</span>
            </li>
          ))}
        </ul>
        <div class="border-l-4 border-teal bg-teal/5 px-6 py-5">
          <p class="text-navy text-lg leading-relaxed">
            Tout cela vous reste, quel que soit la suite. Un service qui sait compter ce qu'il a ouvert et qui se réunit vingt minutes par semaine ne redevient pas aveugle du jour au lendemain.
          </p>
        </div>
      </div>
    </section>

    <!-- Est-ce le bon moment -->
    <section class="bg-gray-50 py-20 px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-navy mb-8">Est-ce le bon moment pour vous&nbsp;?</h2>
        <p class="text-gray-700 text-lg leading-relaxed mb-10 max-w-3xl">
          Cette porte est la bonne si le problème se voit dans un service en particulier. Si chaque service tient à peu près sa part et que ce qui traîne passe de l'un à l'autre, ce n'est pas ici qu'il faut commencer.
        </p>
        <div class="grid sm:grid-cols-2 gap-6">
          <a href="/plusieurs-services" class="group block border border-gray-200 bg-white rounded-xl overflow-hidden hover:border-teal transition">
            <img src={image('equipe-alignement').src} alt={image('equipe-alignement').alt}
              loading="lazy" width="1600" height="900" class="w-full aspect-[16/9] object-cover object-center" />
            <div class="p-6">
              <p class="text-sm text-gray-500 mb-2">Si ce sont les dossiers entre services qui traînent</p>
              <p class="text-navy font-bold text-lg">Faites travailler ensemble plusieurs services <span class="text-teal-dark">&rarr;</span></p>
            </div>
          </a>
          <a href="/projet-a-plusieurs" class="group block border border-gray-200 bg-white rounded-xl overflow-hidden hover:border-teal transition">
            <img src={image('comex-pacifique').src} alt={image('comex-pacifique').alt}
              loading="lazy" width="1600" height="1200" class="w-full aspect-[16/9] object-cover object-center" />
            <div class="p-6">
              <p class="text-sm text-gray-500 mb-2">S'il vous faut des partenaires et un financement</p>
              <p class="text-navy font-bold text-lg">Montez un projet à plusieurs <span class="text-teal-dark">&rarr;</span></p>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- Appel -->
    <section class="relative bg-navy text-white pt-28 pb-20 px-4 overflow-hidden">
      <Vague position="haut" couleur="gris" forme={3} />
      <div class="relative max-w-3xl mx-auto text-center">
        <h2 class="text-3xl font-bold mb-5">Soixante minutes pour y voir clair</h2>
        <p class="text-gray-200 text-lg leading-relaxed mb-8">
          Un premier échange, confidentiel. Vous repartez avec une lecture de votre situation et deux ou trois pistes concrètes. Si ce n'est pas le bon moment, nous vous le dirons aussi.
        </p>
        <a href="/contact" class="inline-block bg-teal hover:bg-teal-light text-gray-900 font-semibold px-8 py-4 rounded-lg transition">
          Parler à quelqu'un
        </a>
      </div>
    </section>

  </main>
  <Footer />
</Base>
