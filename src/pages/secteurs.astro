---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PhotoBande from '../components/PhotoBande.astro';
import Vague from '../components/Vague.astro';
import Icone from '../components/Icone.astro';
---

<Base title="Secteurs — Industrie, BTP, Energie, Banque — Nouvelle-Caledonie" description="PerfEco intervient dans l'industrie, l'énergie, le BTP, la banque, le secteur public en Nouvelle-Calédonie et Polynésie française.">
  <Nav />
  <main class="pt-16">
    <section class="relative bg-navy text-white pt-20 pb-28 px-4 overflow-hidden">
      <img src="/photos/comex-pacifique.jpg" alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover object-center opacity-25" />
      <div class="absolute inset-0 bg-gradient-to-r from-navy via-navy/95 to-navy/55"></div>
      <div class="relative max-w-3xl mx-auto">
        <p class="text-white font-semibold text-sm uppercase tracking-wide mb-3">Secteurs</p>
        <h1 class="text-4xl sm:text-5xl font-bold mb-6">Des environnements complexes, une méthode adaptée</h1>
        <p class="text-gray-200 text-lg">Filiales de groupes internationaux, multi-entités, contraintes réglementaires locales — PerfEco connaît ces contextes de l'intérieur.</p>
      </div>
      <Vague couleur="blanc" forme={2} />
    </section>

    <section class="py-20 px-4">
      <div class="max-w-5xl mx-auto">
        <div class="grid sm:grid-cols-2 gap-8">
          {[
            {
              icon: 'factory',
              title: 'Industrie & Énergie',
              refs: 'ENGIE, Vale, Prony Resources, TotalEnergies, Enercal',
              desc: 'Environnements sous pression réglementaire et technique. Enjeux de reporting multi-niveaux, de gouvernance SI et de pilotage de projets industriels complexes.',
              enjeux: ['Fiabilité des reportings de production', 'Pilotage multi-entités', 'Conformité réglementaire', 'Transformation organisationnelle'],
            },
            {
              icon: 'hard-hat',
              title: 'BTP & Maintenance',
              refs: 'Dumez, VCOM, groupes multi-entités',
              desc: 'Groupes en transformation nécessitant une structuration solide et une digitalisation pragmatique des processus opérationnels.',
              enjeux: ['Structuration multi-entités', 'Suivi de chantiers', 'Adoption des outils', 'Coordination inter-équipes'],
            },
            {
              icon: 'landmark',
              title: 'Banque & Assurances',
              refs: 'Structures financières du Pacifique',
              desc: 'Contraintes réglementaires locales et régionales. Besoins de reporting fiable, de conformité et de pilotage des risques.',
              enjeux: ['Pilotage des risques', 'Reporting réglementaire', 'Simplification des processus', 'Gouvernance des données'],
            },
            {
              icon: 'building-2',
              title: 'Secteur public & Parapublic',
              refs: 'Province Sud, OPT, CCI, CAFAT, CHT Médipôle, CHS',
              desc: 'Collectivités et établissements publics NC & PF confrontés à des pressions budgétaires croissantes et des besoins de modernisation.',
              enjeux: ['Optimisation budgétaire', 'Digitalisation des services', 'Performance des équipes', 'Reporting aux tutelles'],
            },
          ].map(s => (
            <div class="bg-white border border-gray-100 rounded-xl shadow-sm p-8">
              <div class="w-12 h-12 rounded-xl bg-navy/10 text-navy flex items-center justify-center mb-4"><Icone nom={s.icon} class="w-7 h-7" /></div>
              <h2 class="text-xl font-bold text-navy mb-1">{s.title}</h2>
              <p class="text-teal-dark text-xs font-medium mb-4">{s.refs}</p>
              <p class="text-gray-600 text-sm leading-relaxed mb-5">{s.desc}</p>
              <div class="space-y-2">
                {s.enjeux.map(e => (
                  <div class="flex items-center gap-2 text-sm text-gray-600">
                    <span class="w-1.5 h-1.5 bg-teal rounded-full shrink-0"></span>
                    {e}
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>

        <div class="mt-14 bg-navy text-white rounded-2xl p-10 text-center">
          <h2 class="text-2xl font-bold mb-4">Votre secteur n'est pas listé&nbsp;?</h2>
          <p class="text-gray-200 mb-6">PerfEco intervient dans tout environnement organisationnel complexe. La méthode s'adapte — les résultats restent mesurables.</p>
          <a href="/contact" class="inline-flex items-center gap-2 bg-teal hover:bg-teal-light text-gray-900 font-bold px-6 py-3 rounded-lg transition-colors">
            Discuter de votre contexte
          </a>
        </div>
      </div>
    </section>
    <PhotoBande cle="equipe-alignement" format="16/9" fond="gris"
      legende="Des contextes différents, la même question : comment les équipes se mettent-elles d'accord ?" />

  </main>
  <Footer />
</Base>
