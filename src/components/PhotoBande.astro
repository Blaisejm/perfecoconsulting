---
// Bandeau photo entre deux sections de texte.
//
// Posé le 06/10/2026. L'image et son texte de remplacement viennent du
// catalogue src/data/images.js : une page ne réécrit jamais un `alt`, donc il
// ne peut pas diverger d'une page à l'autre.
//
// GARDE-FOU ajouté le 07/10/2026 après un vrai défaut en ligne : `jmb-couloir`,
// une photo verticale (4/5), était affichée dans un cadre horizontal (3/2).
// `object-cover` a fait ce qu'on lui demandait — il a rogné le haut et le bas,
// et la tête du sujet a disparu de la page /a-propos. Personne ne l'avait vu.
// Désormais, un écart de cadrage supérieur à 25 % ARRÊTE la compilation, sauf
// si la page a choisi un ancrage explicite. Le choix doit être conscient.
import { image } from '../data/images.js';

interface Props {
  /** Clé du catalogue d'images. */
  cle: string;
  /** Légende sous l'image. Facultative. */
  legende?: string;
  /** Format d'affichage. La photo est recadrée pour l'occuper. */
  format?: '21/9' | '16/9' | '3/2' | '4/3' | '4/5';
  /** Fond de la bande. */
  fond?: 'blanc' | 'gris';
  /** Partie de la photo à conserver quand le cadre est plus large qu'elle. */
  ancrage?: 'haut' | 'centre' | 'bas';
  /** Largeur de la bande. 'etroite' convient aux photos verticales. */
  largeur?: 'pleine' | 'etroite';
}

const { cle, legende, format = '21/9', fond = 'blanc', ancrage, largeur = 'pleine' } = Astro.props;
const img = image(cle);

// Les classes doivent être ÉCRITES EN TOUTES LETTRES : Tailwind lit le texte
// source pour savoir quoi générer, il ne résout pas `aspect-[${format}]`.
const formats = {
  '21/9': 'aspect-[21/9]',
  '16/9': 'aspect-[16/9]',
  '3/2': 'aspect-[3/2]',
  '4/3': 'aspect-[4/3]',
  '4/5': 'aspect-[4/5]',
};

const ancrages = {
  haut: 'object-top',
  centre: 'object-center',
  bas: 'object-bottom',
};

// Le garde-fou : on compare le format demandé à celui de la source.
const valeur = (r) => {
  const [a, b] = r.split('/').map(Number);
  return a / b;
};
const ecart = valeur(format) / valeur(img.ratio);
if ((ecart > 1.25 || ecart < 0.8) && !ancrage) {
  throw new Error(
    `PhotoBande « ${cle} » : la source est en ${img.ratio} et le cadre demandé en ${format} ` +
      `(écart ×${ecart.toFixed(2)}). object-cover va rogner la photo au point de couper ` +
      `le sujet. Choisissez un format proche de ${img.ratio}, ou passez un ancrage ` +
      `explicite (ancrage="haut" conserve les visages).`
  );
}

const placement = ancrages[ancrage ?? 'centre'];
const colonne = largeur === 'etroite' ? 'max-w-md' : 'max-w-4xl';
---

<section class={`px-4 ${fond === 'gris' ? 'bg-gray-50 py-14' : 'py-14'}`}>
  <figure class={`${colonne} mx-auto`}>
    <img
      src={img.src}
      alt={img.alt}
      loading="lazy"
      decoding="async"
      class={`w-full object-cover ${placement} rounded-xl shadow-md ${formats[format]}`}
    />
    {legende && (
      <figcaption class="text-sm text-gray-500 mt-3 leading-relaxed">{legende}</figcaption>
    )}
  </figure>
</section>
